# Brewfile — run `brew bundle` (or `install.sh`) to install everything below.
# Regenerate the installed-package list with:
#   brew bundle dump --force --describe

# Third-party taps. `brew bundle` installs every tap before anything else
# regardless of position, so this sits at the top for readability, not order.
tap "stablyai/orca"

# CLI tools
brew "fd"                # fast find alternative
brew "ffmpeg-full"       # media transcoding, used by yazi previews
brew "git-delta"         # syntax-highlighted diffs, used as lazygit's diffRenderer
brew "fzf"               # fuzzy finder, used by yazi + shell keybindings
brew "gh"                # GitHub CLI
brew "imagemagick-full"  # image previews (yazi)
brew "jq"                # JSON processor
brew "lazygit"           # terminal git UI (see lazygit/)
brew "neovim"            # editor (see nvim/)
brew "poppler"           # PDF previews (yazi)
brew "resvg"             # SVG previews (yazi)
brew "ripgrep"           # fast grep alternative
brew "sevenzip"          # archive previews/extraction (yazi)
brew "starship"          # shell prompt (see starship/)
brew "uv"                # Python package/venv manager
brew "yazi"              # terminal file manager (see yazi/)
brew "zoxide"            # smarter `cd`

# Apps
cask "font-symbols-only-nerd-font"
cask "ghostty"
cask "heptabase"
cask "itsycal"
cask "karabiner-elements"
cask "stablyai/orca/orca"   # Orca — AI-agent orchestration IDE (stablyai tap)
cask "snipaste"
cask "visual-studio-code"
